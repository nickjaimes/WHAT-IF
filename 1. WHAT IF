# safeway_guardian_mvp.py
"""
Minimum Viable Product - Ready to Run TODAY
"""

import hashlib
import ast
import subprocess
from typing import Dict, List
import warnings

class SafewayGuardianMVP:
    """Initial security scanning for Python code"""
    
    VULNERABILITY_PATTERNS = {
        'sql_injection': [
            'execute(', 'executemany(', 'cursor.execute('
        ],
        'command_injection': [
            'os.system', 'subprocess.call', 'popen'
        ],
        'hardcoded_secrets': [
            'password=', 'secret=', 'api_key=', 'token='
        ],
        'weak_crypto': [
            'md5(', 'sha1(', 'base64.b64decode('
        ]
    }
    
    def __init__(self):
        self.findings = []
    
    def scan_file(self, filepath: str) -> Dict:
        """Scan a Python file for security vulnerabilities"""
        
        with open(filepath, 'r') as f:
            content = f.read()
        
        findings = {
            'file': filepath,
            'vulnerabilities': [],
            'security_score': 100,
            'recommendations': []
        }
        
        # Check each pattern
        for vuln_type, patterns in self.VULNERABILITY_PATTERNS.items():
            for pattern in patterns:
                if pattern in content:
                    findings['vulnerabilities'].append({
                        'type': vuln_type,
                        'pattern': pattern,
                        'severity': self.get_severity(vuln_type)
                    })
                    findings['security_score'] -= 10
        
        # AST-based analysis
        try:
            tree = ast.parse(content)
            findings.update(self.ast_analysis(tree))
        except SyntaxError:
            findings['syntax_errors'] = True
        
        return findings
    
    def ast_analysis(self, tree):
        """Advanced AST-based security analysis"""
        analysis = {'ast_findings': []}
        
        for node in ast.walk(tree):
            # Check for eval usage
            if isinstance(node, ast.Call):
                if isinstance(node.func, ast.Name):
                    if node.func.id == 'eval':
                        analysis['ast_findings'].append({
                            'type': 'dangerous_eval',
                            'line': node.lineno,
                            'recommendation': 'Avoid eval() - use ast.literal_eval() instead'
                        })
            
            # Check for exec usage
            if isinstance(node, ast.Exec):
                analysis['ast_findings'].append({
                    'type': 'dangerous_exec',
                    'line': node.lineno,
                    'recommendation': 'Avoid exec() - refactor code structure'
                })
        
        return analysis
    
    def get_severity(self, vuln_type: str) -> str:
        """Get severity level"""
        severities = {
            'sql_injection': 'CRITICAL',
            'command_injection': 'CRITICAL',
            'hardcoded_secrets': 'HIGH',
            'weak_crypto': 'MEDIUM'
        }
        return severities.get(vuln_type, 'LOW')
    
    def generate_report(self, findings: Dict) -> str:
        """Generate a human-readable report"""
        report = []
        report.append("=" * 60)
        report.append("SAFEWAY GUARDIAN SECURITY REPORT")
        report.append("=" * 60)
        report.append(f"File: {findings['file']}")
        report.append(f"Security Score: {findings['security_score']}/100")
        report.append("")
        
        if findings['vulnerabilities']:
            report.append("🔴 VULNERABILITIES FOUND:")
            for vuln in findings['vulnerabilities']:
                report.append(f"  • {vuln['type'].upper()}: {vuln['pattern']}")
                report.append(f"    Severity: {vuln['severity']}")
                report.append("")
        else:
            report.append("✅ No vulnerabilities detected!")
        
        if findings.get('ast_findings'):
            report.append("⚠️  AST ANALYSIS FINDINGS:")
            for finding in findings['ast_findings']:
                report.append(f"  • Line {finding['line']}: {finding['type']}")
                report.append(f"    Recommendation: {finding['recommendation']}")
        
        return "\n".join(report)

# Usage example
if __name__ == "__main__":
    scanner = SafewayGuardianMVP()
    
    # Scan this file itself
    results = scanner.scan_file(__file__)
    print(scanner.generate_report(results))
    
    print("\n✨ Try scanning your own Python files!")
    print("Usage: scanner.scan_file('your_script.py')")
```

